{
  "name": "@justuchena/design-contract",
  "version": "0.4.0",
  "description": "A design-doc method, the state rules that decide whether an interface tells the truth, 152 design-system references, and a checker that enforces the rules a machine can hold.",
  "keywords": [
    "design-system",
    "design-tokens",
    "design-review",
    "frontend",
    "linter",
    "accessibility",
    "contrast",
    "wcag",
    "tailwindcss",
    "claude-code",
    "ai-agents",
    "agent-skill"
  ],
  "homepage": "https://github.com/justuchena/design-contract#readme",
  "bugs": "https://github.com/justuchena/design-contract/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justuchena/design-contract.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Uchenna Ngozi",
    "email": "uchenangozi@gmail.com",
    "url": "https://github.com/justuchena"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "design-check": "enforce/design-check.mjs",
    "design-contrast": "pipeline/contrast.mjs",
    "design-derive": "pipeline/derive.mjs",
    "design-shots": "pipeline/shots.mjs",
    "design-commit-check": "enforce/commit-check.mjs",
    "design-derive-skill": "pipeline/derive-skill.mjs",
    "design-mutation-report": "pipeline/mutation-report.mjs"
  },
  "scripts": {
    "test": "node enforce/test.mjs",
    "check": "node enforce/design-check.mjs",
    "contrast": "node pipeline/contrast.mjs examples/meridian/palette.json",
    "derive:check": "node pipeline/derive.mjs examples/meridian/tokens.css --check",
    "verify": "node enforce/test.mjs && node pipeline/derive.mjs examples/meridian/tokens.css --check && node pipeline/derive-skill.mjs --check && node enforce/commit-check.mjs --range all",
    "commits": "node enforce/commit-check.mjs --range all",
    "skill": "node pipeline/derive-skill.mjs",
    "mutate": "stryker run",
    "mutate:preflight": "stryker run --dryRunOnly",
    "mutate:report": "node pipeline/mutation-report.mjs"
  },
  "files": [
    "enforce",
    "method",
    "pipeline",
    "examples",
    "resources",
    "SKILL.md",
    "LICENSE",
    "NOTICE",
    "skills",
    ".claude-plugin"
  ],
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0"
  }
}
